{
  "manifest_version": 3,
  "name": "CoinLine",
  "short_name": "CoinLine",
  "version": "1.0.1",
  "description": "Highlight any price on a webpage to instantly see its value in USD or many cryptocurrencies",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://api.exchangerate-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CoinLine: OFF — click to enable",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
