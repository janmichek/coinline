{
  "manifest_version": 3,
  "name": "CoinLine",
  "short_name": "CoinLine",
  "version": "1.0.1",
  "description": "Highlight any price on a webpage to instantly see its value in USD or many cryptocurrencies",
  "browser_specific_settings": {
    "gecko": {
      "id": "coinline@coinline",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://api.exchangerate-api.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "CoinLine: OFF — click to enable",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg"
  }
}
